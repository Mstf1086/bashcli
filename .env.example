# Local development configuration
# Aktif sağlayıcı (bashcli /provider sihirbazı yönetir)
PROVIDER=zenmux
AGENT_MODEL=openai/z-ai/glm-4.7-flash-free

# ZenMux (OpenAI-uyumlu aggregator) — aktif model sağlayıcı
ZENMUX_API_KEY=
ZENMUX_API_BASE=https://zenmux.ai/api/v1

# LiteLLM'in openai provider'ı bu env değişkenlerini de okur
OPENAI_API_KEY=
OPENAI_BASE_URL=

# GCP / Gemini Enterprise — ZenMux kullanıldığı için pasif
# GOOGLE_GENAI_USE_ENTERPRISE=false
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# plan | build | auto
AGENT_MODE=build

# İstek başına azami üretim token'ı. Sağlayıcılar yoksa modelin azami
# değerini (örn. 65535) ister ve düşük bakiyeli hesaplarda istek reddedilir.
AGENT_MAX_TOKENS=4096

# Geçici hatalarda (429/5xx) yeniden deneme sayısı
AGENT_NUM_RETRIES=5
