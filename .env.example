# bashcli ayarları (sağlayıcı DIŞI).
#
# Sağlayıcı, model ve API anahtarı BURAYA yazılmaz: /provider sihirbazı bunları
# ~/.bashcli/providers.json dosyasına (0600) kaydeder. PROVIDER, AGENT_MODEL,
# *_API_KEY, *_API_BASE gibi değişkenler .env içinde olsa bile yüklenmez.

# plan | build | auto
AGENT_MODE=build

# İstek başına azami üretim token'ı. Sağlayıcılar yoksa modelin azami
# değerini (örn. 65535) ister ve düşük bakiyeli hesaplarda istek reddedilir.
AGENT_MAX_TOKENS=4096

# Geçici hatalarda (429/5xx) yeniden deneme sayısı
AGENT_NUM_RETRIES=5
